MAIL_PASSWORD="wwbr bpgk gtiv nbvi"
MAIL_FROM_ADDRESS=rdthemis@gmail.com
MAIL_FROM_NAME="SorvetesGelattoMannia"

# =========================================
# LOG
# =========================================
LOG_LEVEL=info
