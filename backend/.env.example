# =========================================
# EMPRESA
# =========================================
APP_EMPRESA=SORVETES_GELATTO_MANNIA
APP_ENDERECO=Rua_Guarani_191,_Corumbataí_do_Sul_PR
APP_TELEFONE=(44)9.9826-4006

# =========================================
# IMPRESSÃO (fase futura — agente de impressão local)
# =========================================
# URL do agente de impressão rodando na loja. Enquanto esse componente não
# existir, deixe vazio: a impressão automática do cardápio vai falhar de
# forma controlada (o pedido é salvo normalmente, só o campo `impressao` da
# resposta vem com erro).
PRINT_SERVICE_URL=
