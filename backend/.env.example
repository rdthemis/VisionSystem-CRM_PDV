# backend/.env.example
# Copie para .env em ambiente local. No Railway, NÃO suba um .env — configure
# estas mesmas chaves como variáveis de ambiente do serviço (Settings > Variables).

# =========================================
# BANCO DE DADOS
# =========================================
# No Railway: se o MySQL for provisionado como plugin do próprio projeto,
# use variable references em vez de valores fixos, por exemplo:
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_NAME=${{MySQL.MYSQLDATABASE}}
#   DB_USER=${{MySQL.MYSQLUSER}}
#   DB_PASS=${{MySQL.MYSQLPASSWORD}}
DB_HOST=localhost
DB_PORT=3306
DB_NAME=projeto_crm
DB_USER=gelatto_app
DB_PASS=_+gel@tt0_db

# =========================================
# APLICAÇÃO
# =========================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://SEU-BACKEND.up.railway.app

# =========================================
# JWT (gere um novo com: php -r "echo bin2hex(random_bytes(32));")
# =========================================
JWT_SECRET=7b57628afa419a029b15396c2f2cfa5f9d07531093f7eed75683e6905f352311
JWT_EXPIRATION=86400

# =========================================
# CORS — domínio(s) do frontend publicado no Vercel
# =========================================
CORS_ALLOWED_ORIGINS=https://SEU-CARDAPIO.vercel.app
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =========================================
# EMAIL
# =========================================
