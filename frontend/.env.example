# frontend/.env.example
# Local: copie para .env.local (não versionado) e ajuste.
# Vercel: configure REACT_APP_API_URL em Project Settings > Environment
# Variables, com a URL pública do backend no Railway.
# Lembrete: mudou o .env? No Create React App isso só tem efeito com um
# novo build (npm run build) — na Vercel isso já acontece a cada deploy.

REACT_APP_API_URL=https://SEU-BACKEND.up.railway.app
REACT_APP_ENV=production
REACT_APP_DEBUG=false
REACT_APP_NAME="VisionSystem PDV"
REACT_APP_VERSION=1.0.0
